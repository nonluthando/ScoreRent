from fastapi import (
    APIRouter,
    Request,
)

from fastapi.responses import (
    RedirectResponse,
)

from fastapi.templating import (
    Jinja2Templates,
)

from auth import (
    get_current_user,
)

from services.result_service import (
    get_result,
)

router = APIRouter()

templates = Jinja2Templates(
    directory="templates"
)


def require_user(
    request: Request,
):
    """
    Require authenticated user.
    """

    return get_current_user(
        request
    )


@router.get(
    "/results/{evaluation_id}"
)
def results_page(
    request: Request,

    evaluation_id: int,
):
    """
    Evaluation result page.
    """

    user = require_user(
        request
    )

    if not user:

        return RedirectResponse(
            "/login",
            status_code=303,
        )

    result = get_result(
        evaluation_id,

        user["id"],
    )

    if not result:

        return RedirectResponse(
            "/history",
            status_code=303,
        )

    return templates.TemplateResponse(

        "results.html",

        {

            "request":
                request,

            "user":
                user,

            "evaluation":
                result[
                    "evaluation"
                ],

            "listing":
                result[
                    "listing"
                ],

            "reasons":
                result[
                    "reasons"
                ],

            "actions":
                result[
                    "actions"
                ],
        },
    )
