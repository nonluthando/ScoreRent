+            </div>
+            <div class="commuteNumbers">
+              <strong>{{ commute.duration_label }}</strong>
+              <span>{{ commute.distance_km }} km</span>
+            </div>
+          </div>
+        {% endfor %}
+      </div>
+    {% endif %}
+    <p class="muted small">Travel times are estimates and can change with traffic, route conditions, and the exact address.</p>
+  </article>
+
   <article class="card stack">
     <h3>Notes and source</h3>
     <p>{{ listing.notes or 'No personal notes added.' }}</p>
