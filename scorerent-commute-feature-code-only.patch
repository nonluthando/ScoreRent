@@ -0,0 +1,54 @@
+{% extends "base.html" %}
+{% block title %}Destinations · ScoreRent{% endblock %}
+{% block content %}
+<section class="stack" style="padding-top:26px;">
+  <div class="pageHeader">
+    <div>
+      <p class="eyebrow">Travel preferences</p>
+      <h2>Saved destinations</h2>
+      <p class="muted">Save places you travel to regularly, then calculate distance and travel time from any listing.</p>
+    </div>
+    <a class="button" href="/listings">Back to listings</a>
+  </div>
+
+  {% if error %}<div class="alert error">{{ error }}</div>{% endif %}
+  {% if success %}<div class="alert success">{{ success }}</div>{% endif %}
+
+  <div class="grid-2">
+    <article class="card stack">
+      <h3>Add a destination</h3>
+      <form method="post" action="/destinations" class="stack">
+        <label>
+          Label
+          <input name="label" required maxlength="60" placeholder="Work, campus, gym…">
+        </label>
+        <label>
+          Address or place
+          <input name="address" required maxlength="250" placeholder="UCT Upper Campus, Cape Town">
+        </label>
+        <button class="button primary" type="submit">Save destination</button>
+      </form>
+      <p class="muted small">Use a specific suburb, city, or full address for a more accurate result.</p>
+    </article>
+
+    <article class="card stack">
+      <h3>Your destinations</h3>
+      {% if destinations %}
+        {% for destination in destinations %}
+          <div class="detailRow">
+            <div>
+              <strong>{{ destination.label }}</strong>
+              <p class="muted small" style="margin:4px 0 0;">{{ destination.address }}</p>
+            </div>
+            <form method="post" action="/destinations/{{ destination.id }}/delete">
+              <button class="button" type="submit">Remove</button>
+            </form>
+          </div>
+        {% endfor %}
+      {% else %}
+        <p class="muted">No destinations saved yet.</p>
+      {% endif %}
+    </article>
+  </div>
+</section>
+{% endblock %}
