+.breakItem { padding: 13px; border: 1px solid var(--border); border-radius: 10px; }
+.breakTop { display: flex; justify-content: space-between; gap: 16px; }
+.breakTitle { font-size: .8rem; font-weight: 820; }
+.breakDetailsText { margin-top: 4px; color: var(--muted); font-size: .7rem; }
+.breakRight { min-width: 70px; text-align: right; }
+.deltaBadge { display: inline-flex; padding: 4px 7px; border-radius: 999px; font-size: .68rem; font-weight: 900; }
+.deltaBadge.pos { color: var(--success); background: var(--success-soft); }
+.deltaBadge.neg { color: var(--danger); background: var(--danger-soft); }
+.deltaBadge.zero { color: var(--muted); background: var(--surface-soft); }
+.arrowNums { margin-top: 3px; color: var(--muted); font-size: .64rem; }
