+.articleBody { padding: 28px; border: 1px solid var(--border); border-radius: var(--radius); background: white; }
+.articleCallout { padding: 16px; border-left: 4px solid var(--primary); border-radius: 10px; background: var(--primary-soft); }
+
+@media (max-width: 1120px) {
