+.scoreRing {
+  --score-color: var(--warning);
+  width: 168px;
+  height: 168px;
+  padding: 12px;
+  border-radius: 50%;
+  background: conic-gradient(var(--score-color) calc(var(--score) * 1%), #e9efed 0);
