+.tipBubble { position: relative; }
+.tip { color: var(--primary); font-size: .73rem; font-weight: 800; cursor: help; }
+.tipContent { display: none; position: absolute; top: 28px; right: 0; z-index: 20; width: 280px; padding: 14px; border: 1px solid var(--border); border-radius: 11px; background: white; box-shadow: var(--shadow-md); }
+.tipBubble:hover .tipContent, .tipBubble:focus-within .tipContent { display: block; }
+.tipContent p { margin: 0; font-size: .74rem; }
