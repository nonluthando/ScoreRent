+.summary-grid > div { padding: 13px; border-radius: 11px; background: var(--surface-soft); font-size: .83rem; font-weight: 800; }
+.actionList { display: flex; flex-direction: column; gap: 9px; }
+.actionItem { padding: 12px; display: grid; grid-template-columns: 30px 1fr; gap: 11px; align-items: center; border-radius: 10px; background: var(--surface-soft); color: var(--text-soft); font-size: .8rem; }
+.actionNumber { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 9px; color: var(--primary); background: var(--primary-soft); font-weight: 900; }
+.reasonList { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 9px; }
+.reasonList li { padding: 12px 12px 12px 38px; position: relative; border-radius: 10px; background: var(--surface-soft); color: var(--text-soft); font-size: .78rem; }
+.reasonList li::before { content: "•"; position: absolute; left: 14px; top: 8px; color: var(--primary); font-size: 1.3rem; }
+.breakdownDetails summary { cursor: pointer; }
+.breakdownSummary { font-weight: 850; }
