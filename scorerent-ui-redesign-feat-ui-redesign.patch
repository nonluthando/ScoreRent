+.scoreRing.good { --score-color: var(--success); }
+.scoreRing.bad { --score-color: var(--danger); }
+.scoreRingInner { width: 100%; height: 100%; display: grid; place-items: center; align-content: center; border-radius: 50%; background: white; box-shadow: inset 0 0 0 1px var(--border); }
