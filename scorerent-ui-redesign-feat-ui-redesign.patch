+<script>
+  (() => {
+    const form = document.getElementById('compareSelectionForm');
+    if (!form) return;
+    const choices = [...form.querySelectorAll('.comparisonChoice input')];
+    const update = () => choices.forEach((input) => input.closest('.comparisonChoice')?.classList.toggle('selected', input.checked));
+    choices.forEach((input) => input.addEventListener('change', update));
+    form.addEventListener('submit', (event) => {
+      const total = choices.filter((input) => input.checked).length;
+      if (total < 2 || total > 4) {
+        event.preventDefault();
+        window.alert('Choose between two and four listings.');
+      }
+    });
+    update();
+  })();
