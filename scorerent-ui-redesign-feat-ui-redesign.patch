+.resultHeroText > p { max-width: 650px; margin-bottom: 16px; }
+.resultPills { display: flex; flex-wrap: wrap; gap: 7px; }
+.resultWarning { margin-top: 13px; padding: 11px 13px; border-radius: 10px; color: #7a4305; background: var(--warning-soft); font-size: .74rem; }
