+.progressStep { min-height: 52px; padding: 11px 13px; display: flex; align-items: center; gap: 10px; border: 1px solid var(--border); border-radius: 12px; color: var(--muted); background: var(--surface); font-size: .72rem; font-weight: 760; }
+.progressStep span { width: 25px; height: 25px; flex: 0 0 25px; display: grid; place-items: center; border-radius: 8px; background: var(--bg-strong); font-size: .7rem; }
+.progressStep.active { color: var(--primary-deep); border-color: var(--primary-line); background: var(--primary-soft); }
+.progressStep.active span { color: white; background: var(--primary); }
+.uploadDropzone { padding: 38px 24px; text-align: center; border: 1.5px dashed var(--border-strong); border-radius: var(--radius-lg); background: var(--surface-soft); }
+.uploadDropzone:hover { border-color: var(--primary); background: var(--primary-soft); }
+.uploadIcon { width: 56px; height: 56px; margin: 0 auto 16px; display: grid; place-items: center; border-radius: 17px; color: var(--primary); background: var(--primary-soft); }
+.uploadIcon svg { width: 27px; height: 27px; fill: none; stroke: currentColor; stroke-width: 1.7; }
+.uploadDropzone input { margin-top: 16px; }
+.privacyNote { padding: 15px; display: flex; gap: 12px; align-items: flex-start; border-radius: 12px; color: var(--text-soft); background: var(--surface-warm); font-size: .76rem; }
+.privacyNote strong { color: #7a4305; }
+.reviewGrid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; }
+.rawTextDetails summary { cursor: pointer; color: var(--primary); font-weight: 800; }
+.rawTextDetails pre { margin: 16px 0 0; padding: 14px; max-height: 320px; overflow: auto; border-radius: 10px; background: #102824; color: #d8f5ed; font-size: .7rem; }
